DATABASE_URL="file:../data/mealplan.db"
APP_LOGIN_ID=""
APP_LOGIN_PASSWORD=""
AUTH_SECRET=""
# HTTPS reverse proxy 사용 시 true, NAS IP HTTP 접속 시 false
AUTH_COOKIE_SECURE="false"
# OpenRouter direct AI integration. Hermes webhook URL/tokens are not used.
OPENROUTER_API_KEY=""
# Example: google/gemini-2.5-flash
OPENROUTER_MODEL=""
# Recipe generation and chat use OpenRouter web search + page fetch.
OPENROUTER_ENABLE_WEB_SEARCH="true"
# Set false when scheduled Saturday reviews/monthly planning are managed elsewhere.
OPENROUTER_SCHEDULER_ENABLED="true"
# Public HTTPS app URL, used only as OpenRouter request attribution.
OPENROUTER_SITE_URL=""
# Web Push requires HTTPS (or localhost) in the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Shared secret used by the local background worker's notification callback.
MEAL_APP_NOTIFY_TOKEN=""
