generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model FamilyMember {
  id              String           @id @default(cuid())
  name            String
  role            String
  birthDate       DateTime?
  color           String           @default("#e6f3fe")
  dietaryNotes    String?
  allergies       String           @default("")
  chewingAbility  String?
  spiceTolerance  String?
  createdAt       DateTime         @default(now())
  mealPlans       MealPlan[]
  schedules       FamilySchedule[]
}

model Recipe {
  id             String       @id @default(cuid())
  title          String
  description    String?
  prepMinutes    Int          @default(15)
  cookMinutes    Int          @default(20)
  adultServings  Int          @default(2)
  childServings  Int          @default(1)
  tags           String       @default("")
  category       String       @default("주찬")
  plannedDates  String       @default("")
  weekKeys       String       @default("")
  instructions   String       @default("")
  babySplitStep  String?
  storageMethod  String?
  consumeWithin  String?
  sourceUrl      String?
  sourceTitle    String?
  sourceAuthor   String?
  sourceDomain   String?
  sourceCheckedAt DateTime?
  needsReview    Boolean      @default(false)
  ingredients    Ingredient[]
  mealPlans      MealPlan[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Ingredient {
  id String @id @default(cuid())
  name String
  amount String
  category String
  recipeId String
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model MealPlan {
  id               String        @id @default(cuid())
  date             DateTime
  monthKey         String
  mealType         MealType
  lunchPlan        String?
  mainDish         String?
  sideDishes       String        @default("")
  babyMenu         String?
  cookingNote      String?
  changeReason     String?
  adultServings    Int           @default(2)
  childServings    Int           @default(1)
  recipeId         String?
  recipe           Recipe?       @relation(fields: [recipeId], references: [id])
  memberId         String?
  member           FamilyMember? @relation(fields: [memberId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([monthKey, date])
  @@index([date, mealType])
}

model FamilySchedule {
  id             String       @id @default(cuid())
  date           DateTime
  memberId       String
  member         FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  isWorking      Boolean      @default(false)
  eatsAtCompany  Boolean      @default(false)
  isAway         Boolean      @default(false)
  note           String?

  @@unique([date, memberId])
}

model PantryItem {
  id         String   @id @default(cuid())
  name       String   @unique
  quantity   Float
  unit       String
  category   String
  expiresAt  DateTime?
  updatedAt  DateTime @updatedAt
}

model ShoppingWeek {
  id        String         @id @default(cuid())
  startDate DateTime       @unique
  endDate   DateTime
  items     ShoppingItem[]
  createdAt DateTime       @default(now())
}

model ShoppingItem {
  id            String       @id @default(cuid())
  name          String
  quantity      Float
  unit          String
  category      String
  ownedQuantity Float        @default(0)
  usePlan       String
  purchased     Boolean      @default(false)
  weekId        String
  week          ShoppingWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@unique([weekId, name])
}

model BudgetPeriod {
  id            String    @id @default(cuid())
  startDate     DateTime   @unique
  endDate       DateTime
  monthlyLimit  Int        @default(700000)
  weeklyMinimum Int        @default(100000)
  weeklyMaximum Int        @default(120000)
  expenses      Expense[]
  createdAt     DateTime   @default(now())
}

model Expense {
  id          String          @id @default(cuid())
  date        DateTime
  amount      Int
  category    ExpenseCategory
  description String?
  periodId    String
  period      BudgetPeriod    @relation(fields: [periodId], references: [id], onDelete: Cascade)
}

model AgentJob {
  id          String         @id @default(cuid())
  weekStart   DateTime
  action      String
  status      AgentJobStatus @default(RUNNING)
  inputPath   String?
  summary     String?
  error       String?
  createdAt   DateTime       @default(now())
  completedAt DateTime?

  @@index([weekStart, createdAt])
}

model AgentChat {
  id          String   @id
  question    String
  status      String   @default("RUNNING")
  answer      String?
  sources     String?
  error       String?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([createdAt])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

enum ExpenseCategory {
  GROCERIES
  BABY_FOOD
  DINING_OUT
  DELIVERY
  OTHER
}

enum AgentJobStatus {
  RUNNING
  COMPLETED
  FAILED
}
